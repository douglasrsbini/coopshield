{
  "productName": "CoopShield",
  "version": "1.0.0",
  "identifier": "com.sicoob.coopshield",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "title": "CoopShield",
        "width": 1280,
        "height": 720,
        "maximized": true,
        "visible": false,
        "label": "main"
      },
      {
        "title": "Iniciando...",
        "width": 400,
        "height": 280,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "resizable": false,
        "label": "splashscreen",
        "url": "/splash.html"
      }
    ],
    "security": {
      "csp": null
    }
  }
}
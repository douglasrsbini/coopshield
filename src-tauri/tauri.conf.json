{
  "productName": "Kopher Shield",
  "version": "1.0.0",
  "identifier": "com.binaver.kophershield",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "eula.txt",
    "windows": {
      "nsis": {}
    }
  },
  "app": {
    "windows": [
      {
        "title": "Kopher Shield",
        "width": 1280,
        "height": 720,
        "maximized": true,
        "visible": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  }
}
{
  "productName": "Kopher Shield",
  "version": "1.0.0",
  "identifier": "com.sicoob.coopshield",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "title": "Kopher Shield",
        "width": 1280,
        "height": 720,
        "maximized": true,
        "visible": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  }
}